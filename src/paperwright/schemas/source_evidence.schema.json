{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperwright.local/schemas/source_evidence.schema.json",
  "title": "PaperWright Source Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_sha256", "providers", "alignments_path", "alignments_sha256", "claims_path", "claims_sha256", "conflicts_path", "conflicts_sha256", "summary"],
  "properties": {
    "contract_version": {"const": "paperwright-source-evidence-v0.1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "version", "capabilities", "missing_capabilities", "snapshot_path", "snapshot_sha256", "status"],
        "properties": {
          "provider_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "missing_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "snapshot_path": {"type": "string", "minLength": 1},
          "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["complete", "degraded", "unavailable"]}
        }
      }
    },
    "alignments_path": {"type": "string", "minLength": 1},
    "alignments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims_path": {"type": "string", "minLength": 1},
    "claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conflicts_path": {"type": "string", "minLength": 1},
    "conflicts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_count", "observation_count", "alignment_count", "claim_count", "conflict_count"],
      "properties": {
        "provider_count": {"type": "integer", "minimum": 1},
        "observation_count": {"type": "integer", "minimum": 0},
        "alignment_count": {"type": "integer", "minimum": 0},
        "claim_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
