{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperwright.local/schemas/physical_document-v0.2.json",
  "title": "PaperWright PhysicalDocument v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_sha256",
    "backend",
    "backend_version",
    "page_count",
    "metadata",
    "pages"
  ],
  "properties": {
    "contract_version": {
      "const": "paperwright-physical-document-v0.2"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {"type": "string", "minLength": 1},
    "backend_version": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "method",
        "source_ref",
        "confidence",
        "unavailable_reason"
      ],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "confidence": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "unavailable_reason": {
          "anyOf": [{"type": "string"}, {"type": "null"}]
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "kind",
        "page_index",
        "bbox",
        "text",
        "source_object_id",
        "provenance",
        "metadata"
      ],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["text", "image", "vector", "link", "annotation"]
        },
        "page_index": {"type": "integer", "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "source_object_id": {
          "anyOf": [{"type": "string"}, {"type": "null"}]
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"type": "object"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_index",
        "width",
        "height",
        "rotation",
        "coordinate_system",
        "elements"
      ],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "rotation": {"enum": [0, 90, 180, 270]},
        "coordinate_system": {"const": "top-left/pdf-point/y-down"},
        "elements": {
          "type": "array",
          "items": {"$ref": "#/$defs/element"}
        }
      }
    }
  }
}
