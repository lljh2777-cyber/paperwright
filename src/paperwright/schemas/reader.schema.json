{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperwright.local/schemas/reader-v0.1.json",
  "title": "PaperWright reader index v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_sha256",
    "article",
    "capabilities",
    "blocks",
    "assets",
    "relations"
  ],
  "properties": {
    "contract_version": {"const": "paperwright-reader-v0.1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "anchor_contract", "block_fingerprint_version"],
      "properties": {
        "path": {"const": "article.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "anchor_contract": {"const": "paperwright-markdown-anchor-v0.1"},
        "block_fingerprint_version": {"const": "paperwright-visible-block-fingerprint-v0.1"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_semantics", "caption_binding", "body_references"],
      "properties": {
        "layout_semantics": {"const": "reviewed"},
        "caption_binding": {"const": "reviewed-layout-geometry"},
        "body_references": {"const": "unavailable"}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "bbox", "region_id", "paragraph_index", "elements_sha256"],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "region_id": {"type": ["string", "null"]},
        "paragraph_index": {"type": ["integer", "null"], "minimum": 0},
        "elements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order", "anchor", "fingerprint", "source_spans", "asset_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:blk|slot)_[0-9a-f]{24}$"},
        "kind": {"enum": ["title", "heading", "body", "caption", "footnote", "visual_slot", "unknown"]},
        "order": {"type": "integer", "minimum": 1},
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntax", "id"],
          "properties": {
            "syntax": {"enum": ["pwwd:block", "pwwd:slot"]},
            "id": {"type": "string", "pattern": "^(?:blk|slot)_[0-9a-f]{24}$"}
          }
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_text_sha256", "simhash64", "text_length"],
          "properties": {
            "visible_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "simhash64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "text_length": {"type": "integer", "minimum": 0}
          }
        },
        "source_spans": {"type": "array", "items": {"$ref": "#/$defs/sourceSpan"}},
        "asset_id": {"type": ["string", "null"], "pattern": "^ast_[0-9a-f]{24}$"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "size_bytes", "width_px", "height_px", "display_label", "caption_block_id", "placement_block_id", "source_spans"],
      "properties": {
        "id": {"type": "string", "pattern": "^ast_[0-9a-f]{24}$"},
        "kind": {"enum": ["figure", "table", "equation", "unknown"]},
        "path": {"type": "string", "pattern": "^images/[^/]+\\.png$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "display_label": {"type": ["string", "null"]},
        "caption_block_id": {"type": ["string", "null"], "pattern": "^blk_[0-9a-f]{24}$"},
        "placement_block_id": {"type": "string", "pattern": "^slot_[0-9a-f]{24}$"},
        "source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSpan"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source_id", "target_id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^rel_[0-9a-f]{24}$"},
        "type": {"enum": ["places", "caption-of"]},
        "source_id": {"type": "string", "pattern": "^(?:blk|slot)_[0-9a-f]{24}$"},
        "target_id": {"type": "string", "pattern": "^ast_[0-9a-f]{24}$"},
        "label": {"type": ["string", "null"]}
      }
    }
  }
}
