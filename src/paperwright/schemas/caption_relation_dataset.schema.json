{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperwright.local/schemas/caption_relation_dataset.schema.json",
  "title": "PaperWright scientific-paper caption relation dataset v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dataset_id", "quality_tier", "scope", "documents", "examples", "summary"],
  "properties": {
    "contract_version": {"const": "paperwright-caption-relation-dataset-v0.1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "quality_tier": {"enum": ["silver", "gold"]},
    "scope": {"const": "scientific-paper-caption-visual-relations"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "source_sha256", "page_count"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["example_id", "document_id", "relation_scope", "visual_page_index", "caption_page_index", "caption_kind", "label", "caption_evidence", "page_evidence", "adjudication"],
        "properties": {
          "example_id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "relation_scope": {"const": "cross_page_adjacent"},
          "visual_page_index": {"type": "integer", "minimum": 0},
          "caption_page_index": {"type": "integer", "minimum": 1},
          "caption_kind": {"enum": ["figure", "table"]},
          "label": {"enum": ["positive", "negative", "uncertain"]},
          "caption_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anchor_element_id", "text_prefix", "text_sha256", "normalized_y"],
            "properties": {
              "anchor_element_id": {"type": "string", "minLength": 1},
              "text_prefix": {"type": "string", "minLength": 1, "maxLength": 160},
              "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "normalized_y": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "page_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["visual_page_image_sha256", "caption_page_image_sha256", "signals"],
            "properties": {
              "visual_page_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "caption_page_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reviewer", "confidence", "rationale_code", "source_annotation"],
            "properties": {
              "status": {"enum": ["seed_verified", "human_verified"]},
              "reviewer": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["high", "medium", "low"]},
              "rationale_code": {"enum": ["explicit_see_next_page", "full_page_visual_then_caption", "same_page_visual", "previous_page_no_visual", "ambiguous_page_evidence"]},
              "source_annotation": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_count", "example_count", "positive_document_count", "by_label", "by_kind"],
      "properties": {
        "document_count": {"type": "integer", "minimum": 1},
        "example_count": {"type": "integer", "minimum": 1},
        "positive_document_count": {"type": "integer", "minimum": 0},
        "by_label": {"type": "object", "additionalProperties": false, "required": ["negative", "positive", "uncertain"], "properties": {"negative": {"type": "integer", "minimum": 0}, "positive": {"type": "integer", "minimum": 0}, "uncertain": {"type": "integer", "minimum": 0}}},
        "by_kind": {"type": "object", "additionalProperties": false, "required": ["figure", "table"], "properties": {"figure": {"type": "integer", "minimum": 0}, "table": {"type": "integer", "minimum": 0}}}
      }
    }
  }
}
