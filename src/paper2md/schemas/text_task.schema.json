{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2md.local/schemas/text-task-v0.1.json",
  "title": "Paper2MD source-preserving text task v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_sha256",
    "article_model",
    "policy",
    "blocks"
  ],
  "properties": {
    "contract_version": {"const": "paper2md-text-task-v0.1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "article_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "sha256"],
      "properties": {
        "contract_version": {"const": "paper2md-article-model-v0.1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_source",
        "allowed_operations",
        "allowed_change_modes",
        "immutable_fields",
        "text_equivalence_version"
      ],
      "properties": {
        "text_source": {"const": "born-digital-native-pdf"},
        "allowed_operations": {
          "type": "array",
          "prefixItems": [{"const": "replace-markdown"}],
          "minItems": 1,
          "maxItems": 1
        },
        "allowed_change_modes": {
          "type": "array",
          "prefixItems": [
            {"const": "format-only"},
            {"const": "dehyphenation"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "immutable_fields": {
          "const": [
            "id",
            "kind",
            "order",
            "source_spans",
            "asset_id",
            "assets",
            "relations"
          ]
        },
        "text_equivalence_version": {
          "const": "paper2md-text-equivalence-v0.1"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "order",
          "markdown",
          "markdown_sha256",
          "visible_text_sha256",
          "editable"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:blk|slot)_[0-9a-f]{24}$"},
          "kind": {
            "enum": [
              "title",
              "heading",
              "body",
              "caption",
              "footnote",
              "visual_slot",
              "unknown"
            ]
          },
          "order": {"type": "integer", "minimum": 1},
          "markdown": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
          "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "visible_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "editable": {"type": "boolean"}
        }
      }
    }
  }
}
