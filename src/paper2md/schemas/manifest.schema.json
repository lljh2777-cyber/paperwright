{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper2md.local/schemas/manifest-v0.4-v0.5.json",
  "title": "Paper2MD manifest v0.4/v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "source_sha256",
    "backend",
    "contract_version",
    "page_count",
    "status",
    "outputs",
    "warnings"
  ],
  "properties": {
    "manifest_version": {
      "enum": ["paper2md-manifest-v0.4", "paper2md-manifest-v0.5"]
    },
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "contract_version": {
      "const": "paper2md-physical-document-v0.2"
    },
    "page_count": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["success", "success_with_degradation", "failed"]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "object"}
    },
    "region_render_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "page_indices", "max_candidates_per_document"],
      "properties": {
        "mode": {"enum": ["explicit", "auto"]},
        "page_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "max_candidates_per_document": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {"type": "object"}
    },
    "images": {
      "type": "array",
      "items": {"type": "object"}
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "figure_id",
          "page",
          "bbox",
          "member_element_ids",
          "source_object_ids",
          "extraction_mode",
          "asset",
          "native_asset",
          "region_render",
          "caption",
          "evidence_status",
          "degraded_reasons",
          "vector_evidence",
          "markdown_placement"
        ],
        "properties": {
          "figure_id": {"type": "string", "pattern": "^fig-p[0-9]{3}-[0-9]{3}$"},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"$ref": "#/$defs/bbox"},
          "member_element_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_object_ids": {
            "type": "array",
            "items": {"type": ["string", "null"]}
          },
          "extraction_mode": {"enum": ["embedded", "grouped", "region-rendered"]},
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes", "width_px", "height_px"],
            "properties": {
              "path": {"type": "string", "pattern": "^images/[^/]+\\.png$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "width_px": {"type": "integer", "minimum": 1},
              "height_px": {"type": "integer", "minimum": 1}
            }
          },
          "native_asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "path",
              "sha256",
              "size_bytes",
              "width_px",
              "height_px",
              "retained_for_provenance"
            ],
            "properties": {
              "mode": {"enum": ["embedded", "grouped"]},
              "path": {"type": "string", "pattern": "^images/[^/]+\\.png$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "width_px": {"type": "integer", "minimum": 1},
              "height_px": {"type": "integer", "minimum": 1},
              "retained_for_provenance": {"const": true}
            }
          },
          "region_render": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "bbox",
              "scale",
              "dpi",
              "rotation",
              "width_px",
              "height_px",
              "pixel_variance",
              "page_area_ratio",
              "source_pdf_sha256",
              "renderer_version",
              "bbox_rule"
            ],
            "properties": {
              "status": {"enum": ["not_requested", "rendered", "rejected"]},
              "reason": {"type": "string", "minLength": 1},
              "bbox": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/bbox"}]},
              "scale": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "dpi": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "rotation": {"type": ["integer", "null"], "enum": [0, 90, 180, 270, null]},
              "width_px": {"type": ["integer", "null"], "minimum": 1},
              "height_px": {"type": ["integer", "null"], "minimum": 1},
              "pixel_variance": {"type": ["number", "null"], "minimum": 0},
              "page_area_ratio": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 0.82},
              "source_pdf_sha256": {
                "anyOf": [
                  {"type": "null"},
                  {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                ]
              },
              "renderer_version": {"type": ["string", "null"]},
              "bbox_rule": {"type": ["string", "null"]}
            }
          },
          "caption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "confidence",
              "reason",
              "caption_id",
              "element_ids",
              "text",
              "text_sha256",
              "bbox",
              "matching_rule"
            ],
            "properties": {
              "status": {"enum": ["matched", "ambiguous", "none"]},
              "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "reason": {"type": "string", "minLength": 1},
              "caption_id": {"type": ["string", "null"]},
              "element_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "text": {"type": ["string", "null"]},
              "text_sha256": {
                "anyOf": [
                  {"type": "null"},
                  {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                ]
              },
              "bbox": {
                "anyOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/bbox"}
                ]
              },
              "matching_rule": {"type": ["string", "null"]}
            }
          },
          "evidence_status": {"type": "string", "minLength": 1},
          "degraded_reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "vector_evidence": {"type": "object"},
          "markdown_placement": {
            "enum": ["immediately-before-caption", "page-end-degraded"]
          }
        }
      }
    },
    "figure_rejections": {
      "type": "array",
      "items": {"type": "object"}
    },
    "degraded": {
      "type": "array",
      "items": {"type": "object"}
    },
    "physical_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_version": {"const": "paper2md-manifest-v0.5"}
        }
      },
      "then": {"required": ["region_render_policy"]},
      "else": {"not": {"required": ["region_render_policy"]}}
    }
  ],
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
